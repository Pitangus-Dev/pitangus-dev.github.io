---
// A fly from the same plate as the kiskadee, which catches them on the wing: a pencil underdrawing, washes a little off
// the line (as watercolour is), ink outlines, jointed legs, veined wings over a banded abdomen and rufous eyes.
// Plain strokes only (no patterns, ids or filters): it is drawn many times on a page, at sizes from 16 to 64 px.
// Decorative: what it stands for is always said in text next to it.
interface Props { class?: string; size?: number }
const { class: className = '', size = 28 } = Astro.props
const wing = 'M.55 -.85 C2.6 -.55 4.5 1.1 4.85 3.05 C5 3.85 4.35 4.3 3.6 3.9 C2.2 3.05 1 1.4 .55 -.85 Z'
const abdomen = 'M0 -.4 C1.2 -.4 1.75 .9 1.7 2.1 C1.65 3.3 .95 4.4 0 4.6 C-.95 4.4 -1.65 3.3 -1.7 2.1 C-1.75 .9 -1.2 -.4 0 -.4 Z'
---
<svg class={`bug ${className}`} viewBox="-6 -5.4 12 10.4" width={size} height={size * 0.87} aria-hidden="true" data-bug>
  <g fill="none" stroke="#8E8776" stroke-width=".12" stroke-linecap="round" opacity=".5">
    <ellipse cx=".1" cy=".4" rx="3.1" ry="4.3" stroke-dasharray=".5 .4" />
    <path d="M0 -4.9 V5.1" />
  </g>
  <g fill="none" stroke="#1C1A16" stroke-width=".3" stroke-linecap="round" stroke-linejoin="round">
    <path d="M.9 -1.7 2.3 -2.7 2.9 -3.9 M-.9 -1.7 -2.3 -2.7 -2.9 -3.9" />
    <path d="M1.3 -.8 2.9 -.6 4 -1.3 M-1.3 -.8 -2.9 -.6 -4 -1.3" />
    <path d="M1 .1 2.4 1.5 3 3 M-1 .1 -2.4 1.5 -3 3" />
  </g>
  <path d={abdomen} fill="#6B5F3E" transform="translate(.2 .15)" />
  <path d="M-1.6 1.3 H1.6 M-1.65 2.4 H1.65 M-1.35 3.5 H1.35" stroke="#1C1A16" stroke-width=".32" opacity=".55" />
  <path d={abdomen} fill="none" stroke="#1C1A16" stroke-width=".3" />
  <g stroke="#1C1A16" stroke-width=".22" stroke-linejoin="round">
    <path d={wing} fill="#FFF8E6" fill-opacity=".62" />
    <path d={wing} fill="#FFF8E6" fill-opacity=".62" transform="scale(-1 1)" />
  </g>
  <path d="M1.1 -.2 C2.4 .6 3.5 1.9 4.2 3.4 M1.6 .1 C2.2 1.2 2.9 2.4 3.7 3.4 M-1.1 -.2 C-2.4 .6 -3.5 1.9 -4.2 3.4 M-1.6 .1 C-2.2 1.2 -2.9 2.4 -3.7 3.4"
        fill="none" stroke="#1C1A16" stroke-width=".1" stroke-linecap="round" opacity=".55" />
  <ellipse cy="-1.15" rx="1.45" ry="1.2" fill="#4A463C" transform="translate(.15 .12)" />
  <path d="M-.45 -2 V-.4 M.45 -2 V-.4" stroke="#8E8776" stroke-width=".26" stroke-linecap="round" />
  <ellipse cy="-1.15" rx="1.45" ry="1.2" fill="none" stroke="#1C1A16" stroke-width=".3" />
  <ellipse cy="-2.95" rx="1.25" ry=".8" fill="#2E2B24" stroke="#1C1A16" stroke-width=".26" />
  <ellipse cx="-.72" cy="-3.05" rx=".66" ry=".78" fill="#9C4A1E" stroke="#1C1A16" stroke-width=".22" />
  <ellipse cx=".72" cy="-3.05" rx=".66" ry=".78" fill="#9C4A1E" stroke="#1C1A16" stroke-width=".22" />
  <circle cx="-.88" cy="-3.32" r=".15" fill="#FFF8E6" /><circle cx=".56" cy="-3.32" r=".15" fill="#FFF8E6" />
</svg>
<style>.bug { overflow: visible; flex: none; }</style>
