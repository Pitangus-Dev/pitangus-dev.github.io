---
// A house fly from the same plate as the kiskadee, which catches them on the wing, seen from above. The six drawings
// (three wingbeats, two steps, at rest) are one sprite, src/assets/plate/flies.webp: the page sets data-state="walk"
// or "fly" on the moving ones and the CSS below picks the frames; without it, the fly rests with its wings folded.
// `live` is kept for the moving ones (the page's script looks for them); the drawing is the same.
// Decorative: what it stands for is always said in text next to it.
interface Props { class?: string; size?: number; live?: boolean }
const { class: className = '', size = 28 } = Astro.props
---
<span class={`bug ${className}`} style={`--bug-size: ${size}px`} aria-hidden="true" data-bug></span>
<style>
  .bug {
    display: inline-block; flex: none; vertical-align: middle;
    width: var(--bug-size); height: var(--bug-size);
    background: url('../assets/plate/flies.webp') no-repeat 100% 0 / 600% 100%;
  }
  /* At night the black legs would vanish on the dark desk: a faint paper-coloured edge keeps them visible. */
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .bug { filter: drop-shadow(0 0 .6px rgb(251 245 230 / .55)); } }
  :root[data-theme='dark'] .bug { filter: drop-shadow(0 0 .6px rgb(251 245 230 / .55)); }
  .bug[data-state='walk'] { animation: walk .26s steps(1) infinite; }
  .bug[data-state='fly'] { animation: fly .09s steps(1) infinite; }
  @keyframes walk { 0% { background-position-x: 60%; } 50% { background-position-x: 80%; } }
  @keyframes fly { 0% { background-position-x: 0%; } 33% { background-position-x: 20%; } 67% { background-position-x: 40%; } }
  @media (prefers-reduced-motion: reduce) {
    .bug[data-state] { animation: none; }
    .bug[data-state='walk'] { background-position-x: 60%; }
    .bug[data-state='fly'] { background-position-x: 40%; }
  }
</style>
