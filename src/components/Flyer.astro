---
// The kiskadee on the wing, small, for its sallies from the counter (scripts/motion.ts): side view facing right, the
// wing in its own group so it can flap. Decorative.
const INK = '#1C1A16'
---
<svg class="flyer-bird" viewBox="0 0 44 30" width="52" height="36" aria-hidden="true">
  <g stroke={INK} stroke-width="1" stroke-linejoin="round">
    <path d="M3 15 L13 12.5 L14 17 L4 19.5 Z" fill="#9A5226" />
    <path d="M11 15 C12 10.5 18 9 25 9.5 C30 10 33 12 33 15.5 C33 19.5 28 22 21 22 C15 22 11 19.5 11 15 Z" fill="#F2C230" />
  </g>
  <path d="M12 13.5 C14 10.8 19 9.4 25 9.6 C28 9.8 30 10.6 31 11.6 C27 12.4 20 13 12 13.5 Z" fill="#6A5A38" />
  <circle cx="32" cy="11" r="6" fill="#FFFDF5" stroke={INK} stroke-width="1" />
  <path d="M26.4 9.4 C27.2 6.4 30 5 32.6 5 C35 5.1 37 6.6 37.8 9 C34.4 8 30 8 26.4 9.4 Z" fill={INK} />
  <path d="M29.6 5.6 C31 5.2 32.4 5.2 33.6 5.5" fill="none" stroke="#F2C230" stroke-width=".8" stroke-linecap="round" />
  <path d="M26.2 11.6 C29.6 10.6 33.8 10.4 38.2 11.4 L38 13.2 C34.4 12.6 30.2 12.8 26.6 14 Z" fill={INK} />
  <circle cx="34" cy="11.9" r=".9" fill="#6B3F1F" />
  <path d="M37.6 11 L43.5 12.2 L37.6 13.4 Z" fill={INK} />
  <g class="flyer-wing">
    <path d="M16 12 C17 6 21 1.5 27 1 C25.5 4.5 24.5 8.5 24 12 Z" fill="#54402A" stroke={INK} stroke-width="1" stroke-linejoin="round" />
    <path d="M18 11 C19 7 21.5 4 25 2.4 M20.4 11.2 C21.2 8 22.6 5.4 25.4 3.6" fill="none" stroke="#B05A2C" stroke-width="1" stroke-linecap="round" />
  </g>
</svg>
