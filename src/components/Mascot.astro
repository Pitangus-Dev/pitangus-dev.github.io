---
// The kiskadee (Pitangus sulphuratus) of the logo, perched on a branch, drawn as a naturalist's plate in three layers
// that scripts/motion.ts brings in one after the other: a pencil underdrawing (the circle of the head, the oval of the
// body, the line of the pose and the perch; data-pencil), the ink (data-ink-layer, revealed from the top down) and the
// colour (data-wash). The illustration is traced from a reference into flat brand colours (assets/plate/: the full plate
// and its ink alone, same viewBox); the eye is drawn on top, so its iris and pupil (data-pupil) can look toward the pointer,
// up to data-reach drawing units from where they rest, and its lid (data-lid) can blink.
import plate from '../assets/plate/bichofue.svg?url'
import inkOnly from '../assets/plate/bichofue-ink.svg?url'
interface Props { class?: string; label: string }
const { class: className = '', label } = Astro.props
const VIEWBOX = '40 68 1171 1131'
const INK = '#1C1A16'
const WHITE = '#FFFDF5'
const pencil = { fill: 'none', stroke: '#8E8776', 'stroke-width': 3, 'stroke-linecap': 'round', opacity: 0.55, 'data-pencil': '' } as const
const eye = { x: 760, y: 163 }
---
<div class={`mascot ${className}`} role="img" aria-label={label} data-mascot>
  <div class="mascot-figure">
    <svg class="mascot-layer" viewBox={VIEWBOX} aria-hidden="true">
      <circle cx="735" cy="178" r="118" {...pencil} stroke-dasharray="16 12" />
      <ellipse cx="625" cy="530" rx="180" ry="320" transform="rotate(26 625 530)" {...pencil} stroke-dasharray="16 12" />
      <path d="M800 66 C700 400 560 760 372 1190" {...pencil} />
      <path d="M640 148 L990 128" {...pencil} />
      <path d="M44 1012 L1004 756" {...pencil} />
    </svg>
    <img class="mascot-layer" src={inkOnly} alt="" decoding="async" data-ink-layer />
    <img class="mascot-layer" src={plate} alt="" decoding="async" data-wash />
    <svg class="mascot-layer" viewBox={VIEWBOX} aria-hidden="true">
      <!-- The eye: a pale rim round a dark brown iris and its pupil, which look toward the pointer (data-pupil) inside
           the rim; the catchlight stays put, as a reflection of the light does. -->
      <defs><clipPath id="mascot-eye-rim"><ellipse cx={eye.x} cy={eye.y} rx="22" ry="17.5" /></clipPath></defs>
      <g data-eye data-reach="5">
        <ellipse cx={eye.x} cy={eye.y} rx="23" ry="18.5" fill={INK} stroke="#7A766C" stroke-width="2.6" data-wash />
        <g clip-path="url(#mascot-eye-rim)">
          <g data-pupil>
            <circle cx={eye.x + 1} cy={eye.y - 1} r="16" fill="#6B3F1F" data-wash />
            <circle cx={eye.x + 1.5} cy={eye.y - 1} r="8.5" fill={INK} data-wash />
          </g>
        </g>
        <circle cx={eye.x - 2.5} cy={eye.y - 8} r="4.2" fill={WHITE} data-wash />
        <!-- The eyelid hangs from the top of the eye (its group's origin), so scaling it from 0 0 closes it; open, it
             has no height. -->
        <g transform={`translate(${eye.x} ${eye.y - 20})`}>
          <ellipse cx="0" cy="20" rx="25.5" ry="20" fill={INK} data-lid transform="scale(1 0)" />
        </g>
      </g>
    </svg>
  </div>
</div>

<style>
  .mascot { position: relative; width: 100%; aspect-ratio: 1171 / 1131; }
  .mascot-figure { position: absolute; inset: 0; }
  .mascot-layer { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  /* Until the script draws it (or gives up), the drawing stays hidden: no flash of the finished plate. */
  :global(html.pending) .mascot { visibility: hidden; }
</style>
