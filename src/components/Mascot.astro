---
// The kiskadee (Pitangus sulphuratus) of the logo, perched on a branch and drawn like a naturalist's plate: a pencil
// underdrawing (the circle of the head, the oval of the body, the line of the pose; data-pencil), the flat colour
// (data-wash), pen hatching in the shadows and brush strokes in the plumage (data-wash too), and the ink outlines on
// top (data-ink, pathLength 1), sketched first by scripts/motion.ts. The tip of the bill carries data-tongue="start":
// the flight line is drawn from there. The eye's catchlight (data-pupil) follows the pointer, up to data-reach
// from where it rests. All of it is plain SVG: no filters, nothing recomputed while it breathes.
interface Props { class?: string; label: string }
const { class: className = '', label } = Astro.props
const INK = '#1C1A16'
const WHITE = '#FFFDF5'
const SULPHUR = '#F2C230'  // azufre, as in the logo
const SULPHUR_DEEP = '#D9A51C'
const OLIVE = '#5E5233'
const OLIVE_LIGHT = '#7A6C47'
const BROWN = '#463C28'
const RUFOUS = '#A8552A'
const BARK = '#8C6B4C'
const LEAF = '#8EA06A'
const ink: astroHTML.JSX.SVGAttributes & { 'data-ink': string } = {
  fill: 'none', stroke: INK, 'stroke-width': 0.42, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', pathLength: 1, 'data-ink': '',
}
const pencil: astroHTML.JSX.SVGAttributes & { 'data-pencil': string } = {
  fill: 'none', stroke: '#8E8776', 'stroke-width': 0.18, 'stroke-linecap': 'round', opacity: 0.55, 'data-pencil': '',
}
// The head and its throat, down to where the yellow of the breast begins; the bill is drawn over its front.
const head = 'M36 12.9 C35.9 11.6 35.4 10.3 34.4 9.3 C32.6 7.6 30 7 27.6 7.2 C26.4 7.2 25.4 7 24.2 6.2 C24.5 7 24.7 7.5 24.8 8 C23.8 7.7 22.8 7.6 21.4 7.8 C22 8.4 22.4 8.9 22.7 9.5 C21.9 9.6 21.1 9.9 20.1 10.5 C20.8 10.9 21.2 11.3 21.4 11.9 C21 12.9 20.9 13.9 21 15 C21.1 17.2 21.4 19 21 21.6 L24.6 21.8 C28 22.2 32.4 21.8 35.9 20.5 C36.5 19.5 36.8 18.5 36.6 17.4 Z'
const headLine = 'M35.9 20.5 C36.5 19.5 36.8 18.5 36.6 17.4 L36 12.9 C35.9 11.6 35.4 10.3 34.4 9.3 C32.6 7.6 30 7 27.6 7.2 C26.4 7.2 25.4 7 24.2 6.2 C24.5 7 24.7 7.5 24.8 8 C23.8 7.7 22.8 7.6 21.4 7.8 C22 8.4 22.4 8.9 22.7 9.5 C21.9 9.6 21.1 9.9 20.1 10.5 C20.8 10.9 21.2 11.3 21.4 11.9 C21 12.9 20.9 13.9 21 15 C21.1 17.2 21.4 19 21 21.6'
const body = 'M21 20.4 C19.6 23.6 18.6 27.6 18.3 31.6 C18 35.4 19.8 39 23.6 40.6 C26.6 41.6 30.8 41.2 33.8 39 C36.9 36.7 38.6 32.8 38.5 28.8 C38.5 25 37.6 22.2 35.9 20.4 C31 18.6 25 18.8 21 20.4 Z'
const bodyLine = 'M35.9 20.5 C37.6 22.2 38.5 25 38.5 28.8 C38.6 32.8 36.9 36.7 33.8 39 C30.8 41.2 26.6 41.6 23.6 40.6'
const wing = 'M21.2 20.6 C19.6 24 18.6 28.2 17.8 32.4 C17 36.4 16 39.6 14.8 42.4 C15.6 42.6 16.8 41.6 18.2 40.2 C21 37.6 24.4 34.8 26.6 31 C27.8 28.8 28.2 26 27.4 23.8 C26.8 22.2 25.2 21 23.4 20.6 C22.6 20.4 21.8 20.4 21.2 20.6 Z'
const tail = 'M20.4 35.2 C19 39.6 16.6 44 14 48.6 C13.4 48.8 12.9 48.6 12.5 48.3 C11.9 48.7 11.2 48.8 10.4 48.6 C12.4 44.6 14.8 39.6 17.2 35 Z'
const branch = 'M2.2 43.2 C10 42.8 20 42.2 30 41.6 C38 41.1 44 40.4 49.2 39.2 C49.9 39.1 50.2 39.8 49.7 40.2 C44.4 41.8 38.4 43.4 30 44.2 C20 45 10 45.6 2.4 46.4'
const bill = 'M35.8 12.8 C39.8 13.2 44 14.6 48.4 16.9 C48.8 17.1 48.7 17.5 48.2 17.5 C44.2 17.7 40.2 17.8 36.8 17.6 C36.2 16 35.9 14.4 35.8 12.8 Z'
const billLine = 'M35.8 12.8 C39.8 13.2 44 14.6 48.4 16.9 C48.8 17.1 48.7 17.5 48.2 17.5 C44.2 17.7 40.2 17.8 36.8 17.6'
const leaf = 'M45.2 36.4 C46.4 34.4 48.6 33.4 50.8 33.6 C50 35.6 47.6 36.9 45.2 36.4 Z'
const leafSmall = 'M43.4 38 C43.2 36.4 43.8 35 45 34 C45.6 35.4 44.9 37 43.4 38 Z'
const eye = { x: 31.4, y: 13.5, r: 1.85 }
---
<svg class={`mascot ${className}`} viewBox="0 0 52 49" role="img" aria-label={label} data-mascot>
  <defs>
    <pattern id="mascot-hatch" width="1.1" height="1.1" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
      <line x1="0" y1="0" x2="0" y2="1.1" stroke={INK} stroke-width=".16" />
    </pattern>
    <pattern id="mascot-brush" width="1.4" height="1.4" patternUnits="userSpaceOnUse" patternTransform="rotate(62)">
      <line x1="0" y1="0" x2="0" y2="1.4" stroke="#F3E6C8" stroke-width=".12" />
    </pattern>
    <radialGradient id="mascot-fade"><stop offset=".15" stop-color="#fff" /><stop offset="1" stop-color="#000" /></radialGradient>
    <linearGradient id="mascot-down" x1="0" y1="0" x2="0" y2="1"><stop offset=".15" stop-color="#000" /><stop offset="1" stop-color="#fff" /></linearGradient>
    <clipPath id="mascot-head-shape"><path d={head} /></clipPath>
    <clipPath id="mascot-body-shape"><path d={body} /></clipPath>
    <clipPath id="mascot-wing-shape"><path d={wing} /></clipPath>
    <clipPath id="mascot-tail-shape"><path d={tail} /></clipPath>
    <clipPath id="mascot-branch-shape"><path d={`${branch} Z`} /></clipPath>
    <mask id="mascot-breast"><ellipse cx="31.6" cy="22.6" rx="7.4" ry="2.6" fill="url(#mascot-fade)" /></mask>
    <mask id="mascot-flank"><ellipse cx="25.6" cy="36.2" rx="6.4" ry="4.2" fill="url(#mascot-fade)" /></mask>
    <mask id="mascot-chin"><ellipse cx="35.4" cy="19" rx="3" ry="1.8" fill="url(#mascot-fade)" /></mask>
    <mask id="mascot-rump"><ellipse cx="17" cy="37" rx="3.4" ry="3.4" fill="url(#mascot-fade)" /></mask>
    <mask id="mascot-under"><rect x="0" y="40" width="52" height="7" fill="url(#mascot-down)" /></mask>
    <mask id="mascot-primaries"><rect x="12" y="30" width="18" height="13" fill="url(#mascot-down)" /></mask>
  </defs>

  <!-- Construction: the circle of the head, the oval of the body, the line of the pose and of the bill, the perch. -->
  <circle cx="29" cy="13.4" r="6.6" {...pencil} stroke-dasharray=".9 .7" />
  <ellipse cx="28.4" cy="30.6" rx="9.4" ry="11.6" transform="rotate(26 28.4 30.6)" {...pencil} stroke-dasharray=".9 .7" />
  <path d="M33.8 6.4 C31 18 27.8 32 11.4 49" {...pencil} />
  <path d="M29.6 12.8 L49.4 17.8" {...pencil} />
  <path d="M0.6 44.8 L51.4 40.2" {...pencil} />
  <path d={head} {...pencil} transform="translate(.4 -.35) rotate(.6 29 15)" />
  <path d={body} {...pencil} transform="translate(-.35 .3) rotate(-.5 28 30)" />

  <!-- The tail hangs behind the perch. -->
  <g class="mascot-body">
    <path d={tail} fill={BROWN} data-wash />
    <g clip-path="url(#mascot-tail-shape)" data-wash>
      <path d="M16.9 36 C14.8 40.4 12.6 44.6 10.9 48.3" fill="none" stroke={RUFOUS} stroke-width=".55" stroke-linecap="round" />
      <path d="M19.9 36.4 C18.2 40.6 16 44.6 13.6 48.4" fill="none" stroke={RUFOUS} stroke-width=".4" stroke-linecap="round" />
      <path d="M18.7 35.8 C16.9 40.2 14.7 44.4 12.5 48.3" fill="none" stroke={INK} stroke-width=".16" opacity=".55" />
      <rect x="12" y="32" width="10" height="10" fill="url(#mascot-hatch)" mask="url(#mascot-rump)" opacity=".7" />
    </g>
    <path d={tail} {...ink} />
  </g>

  <!-- The perch: bark, a cut end, a twig with two leaves, its underside hatched. -->
  <g class="mascot-perch">
    <path d={`${branch} Z`} fill={BARK} data-wash />
    <g clip-path="url(#mascot-branch-shape)" data-wash>
      <rect x="0" y="40" width="52" height="7" fill="url(#mascot-hatch)" mask="url(#mascot-under)" opacity=".8" />
      <path d="M6 44.6 l2.4 -.2 M13.4 43.6 l3 -.25 M21 44.2 l2.2 -.15 M34.6 42.2 l2.6 -.3 M41 41.6 l2 -.3" stroke="#5E4530" stroke-width=".2" stroke-linecap="round" />
      <path d="M8.6 43.4 c.6 -.3 1.4 -.3 1.9 .1 M37.4 41.6 c.5 -.25 1.2 -.25 1.6 .1" fill="none" stroke="#E9D6B6" stroke-width=".18" stroke-linecap="round" opacity=".8" />
    </g>
    <ellipse cx="2.3" cy="44.8" rx=".9" ry="1.6" fill="#D2AE84" data-wash />
    <ellipse cx="2.3" cy="44.8" rx=".42" ry=".85" fill="none" stroke="#8C6B4C" stroke-width=".14" data-wash />
    <path d="M40.4 41 C42 39.4 43.4 37.8 45.2 36.4" fill="none" stroke={BARK} stroke-width=".7" stroke-linecap="round" data-wash />
    <path d={leaf} fill={LEAF} data-wash />
    <path d={leafSmall} fill={LEAF} data-wash />
    <path d="M45.4 36.3 C47 35.2 48.8 34.3 50.6 33.7 M43.5 37.8 C43.8 36.6 44.3 35.5 44.9 34.3" fill="none" stroke="#5F7340" stroke-width=".16" stroke-linecap="round" data-wash />
    <path d={branch} {...ink} />
    <path d={leaf} {...ink} stroke-width=".3" />
  </g>

  <g class="mascot-body">
    <!-- Sulphur-yellow underparts, deeper along the belly; the shadow of the head on the breast and of the wing on the
         flank; a few feather strokes. -->
    <path d={body} fill={SULPHUR} data-wash />
    <path d="M38.5 27.6 C38.5 33.6 35.4 38.8 29.6 40.9 C26.2 41.7 22.8 41 20.6 39.4 C26.6 39.4 32.4 36.6 35.6 32 C36.9 30.2 37.8 28.6 38.5 27.6 Z" fill={SULPHUR_DEEP} opacity=".5" data-wash />
    <g clip-path="url(#mascot-body-shape)" opacity=".5" data-wash>
      <rect x="22" y="19" width="18" height="8" fill="url(#mascot-hatch)" mask="url(#mascot-breast)" />
      <rect x="18" y="31" width="16" height="11" fill="url(#mascot-hatch)" mask="url(#mascot-flank)" />
    </g>
    <path d="M33.2 25 q.6 .5 1.2 0 M35.6 28.8 q.6 .5 1.2 0 M32 30.4 q.6 .5 1.2 0 M34.8 33.2 q.6 .5 1.2 0 M30.6 34.8 q.6 .5 1.2 0 M36.6 31.2 q.5 .45 1 0"
          fill="none" stroke={SULPHUR_DEEP} stroke-width=".26" stroke-linecap="round" data-wash />
    <path d={bodyLine} {...ink} />

    <!-- The folded wing: olive-brown coverts with pale tips, then the flight feathers, edged in rufous. -->
    <path d={wing} fill={BROWN} data-wash />
    <g clip-path="url(#mascot-wing-shape)" data-wash>
      <path d="M29 19 L29 29.4 C25.6 29.2 21.8 30 18 31.8 L15 19 Z" fill={OLIVE} />
      <path d="M29 19 L29 25.6 C26 25.6 22.6 26.4 19.4 28 L15 19 Z" fill={OLIVE_LIGHT} />
      <path d="M29 19 L29 29.4 C25.6 29.2 21.8 30 18 31.8 L15 19 Z" fill="url(#mascot-brush)" opacity=".35" />
      <path d="M19.8 27.6 q.9 .8 1.8 0 q.9 .8 1.8 0 q.9 .8 1.8 0 q.9 .8 1.8 0 M20.8 24.4 q.8 .7 1.6 0 q.8 .7 1.6 0 q.8 .7 1.6 0"
            fill="none" stroke="#4E3C28" stroke-width=".2" stroke-linecap="round" opacity=".7" />
      <path d="M18.2 31.6 C21.6 30 24.8 29.3 27.6 29.4" fill="none" stroke="#D9B47C" stroke-width=".4" stroke-linecap="round" />
      <path d="M26.4 30.2 C24.2 33.9 20.8 37.4 16.8 41.2 M24.6 29.9 C22.6 33.4 19.6 36.9 16.1 40.6 M22.6 30.1 C20.8 33.3 18.4 36.5 15.6 39.9 M20.6 30.7 C19 33.7 17.2 36.8 15.2 39.4"
            fill="none" stroke={RUFOUS} stroke-width=".42" stroke-linecap="round" />
      <path d="M26 29.9 C23.8 33.6 20.4 37.1 16.4 40.9 M24.2 29.7 C22.2 33.1 19.2 36.6 15.7 40.3 M22.2 29.9 C20.4 33 18 36.2 15.2 39.6"
            fill="none" stroke={INK} stroke-width=".16" stroke-linecap="round" opacity=".6" />
      <rect x="12" y="30" width="18" height="13" fill="url(#mascot-hatch)" mask="url(#mascot-primaries)" opacity=".45" />
    </g>
    <path d={wing} {...ink} />
  </g>

  <!-- Short dark legs, the toes wrapped round the perch. -->
  <g fill="none" stroke={INK} stroke-linecap="round" stroke-linejoin="round" data-wash>
    <path d="M26 40.7 L25.6 42.1 M28.8 40.9 L28.9 41.9" stroke-width=".5" />
    <path d="M25.6 42 C26.6 41.7 27.4 41.9 27.9 42.7 M25.6 42 C24.8 42.1 24.2 42.5 24 43.1 M28.9 41.8 C29.9 41.5 30.6 41.7 31 42.5 M28.9 41.8 C28.2 41.9 27.7 42.3 27.6 42.9" stroke-width=".36" />
  </g>

  <g class="mascot-head">
    <path d={head} fill={WHITE} data-wash />
    <!-- Black crown, its feathers raised at the back; the white eyebrow round to the nape; the black mask through the
         eye; the olive nape. -->
    <g clip-path="url(#mascot-head-shape)" data-wash>
      <path d="M18 4 L40 4 L40 11.6 C38 11.2 36.6 11 35.6 11.4 C34.6 10.4 33.2 9.8 31.5 9.7 C28 9.5 23.8 10.1 21.4 11.9 L18 13 Z" fill={INK} />
      <path d="M36.4 12.6 C34 11.6 32 11 29.5 11.3 C26.5 11.6 23.6 12.6 21 14.4 L19 14.4 L19 18.6 L21.2 17.6 C23.5 16.6 26 16.2 28.6 16 C31.2 15.8 34 16.2 36.6 16.6 L38 16.6 L38 12.6 Z" fill={INK} />
      <path d="M18 17.6 C20.5 17.6 22.6 17.8 24 18.8 C25 19.6 25.6 21 25.9 23 L18 24 Z" fill={OLIVE} />
      <rect x="32" y="16.5" width="6" height="5" fill="url(#mascot-hatch)" mask="url(#mascot-chin)" opacity=".45" />
    </g>
    <path d={headLine} {...ink} />
    <g class="mascot-eye" data-eye data-reach=".6">
      <circle cx={eye.x} cy={eye.y} r={eye.r} fill={INK} data-wash />
      <path d={`M${eye.x - 1.32} ${eye.y - 0.5} A1.42 1.42 0 0 0 ${eye.x + 0.5} ${eye.y + 1.33}`} fill="none" stroke={WHITE} stroke-width=".36" stroke-linecap="round" data-wash />
      <circle cx={eye.x + 0.55} cy={eye.y - 0.6} r=".38" fill={WHITE} data-wash data-pupil />
      <!-- The eyelid hangs from the top of the eye (its group's origin), so scaling it from 0 0 closes it; open, it has
           no height. -->
      <g transform={`translate(${eye.x} ${eye.y - 2.1})`}>
        <ellipse cx="0" cy="2.1" rx="2.15" ry="2.1" fill={INK} data-lid transform="scale(1 0)" />
      </g>
    </g>
    <!-- The long, heavy black bill, with a sheen along the ridge and the nostril. -->
    <path d={bill} fill={INK} data-wash />
    <path d="M37.6 13.6 C41 14.1 44.4 15.2 47 16.4" fill="none" stroke="#6E6A60" stroke-width=".3" stroke-linecap="round" opacity=".8" data-wash />
    <ellipse cx="38.1" cy="14.4" rx=".45" ry=".24" fill="#4A463C" data-wash />
    <path d={billLine} {...ink} />
    <path d="M36.6 15.7 C40 16 44 16.5 47.9 17.25" {...ink} stroke-width=".3" />
    <circle cx="48" cy="17.2" r=".5" fill="none" data-tongue="start" />
  </g>
</svg>

<style>
  .mascot { width: 100%; height: auto; overflow: visible; }
  /* Until the script draws it (or gives up), the drawing stays hidden: no flash of the finished plate. */
  :global(html.pending) .mascot { visibility: hidden; }
</style>
