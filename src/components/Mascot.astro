---
// The kiskadee (Pitangus sulphuratus) of the logo, perched upright on a branch and drawn like a naturalist's plate: a
// pencil underdrawing (the circle of the head, the oval of the body, the line of the pose; data-pencil), the flat colour
// (data-wash), pen hatching in the shadows and brush strokes in the plumage (data-wash too), and the ink outlines on
// top (data-ink, pathLength 1), sketched first by scripts/motion.ts. The eye's catchlight (data-pupil) follows the
// pointer, up to data-reach from where it rests. All of it is plain SVG: no filters, nothing recomputed while it breathes.
// Field marks, as in the bird: a thin black cap with its hidden yellow stripe, a broad white brow that meets on the
// forehead and runs round to the nape, a black mask through the eye, a white throat, a stout bill about half the head
// long, sulphur-yellow underparts, brown wings edged in rufous and a long rufous tail.
interface Props { class?: string; label: string }
const { class: className = '', label } = Astro.props
const INK = '#1C1A16'
const WHITE = '#FFFDF5'
const SULPHUR = '#F2C230'  // azufre, as in the logo
const SULPHUR_DEEP = '#D9A51C'
const OLIVE = '#5E5233'
const OLIVE_LIGHT = '#7A6C47'
const BROWN = '#54402A'
const RUFOUS = '#B05A2C'
const BARK = '#8C6B4C'
const LEAF = '#8EA06A'
const ink: astroHTML.JSX.SVGAttributes & { 'data-ink': string } = {
  fill: 'none', stroke: INK, 'stroke-width': 0.42, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', pathLength: 1, 'data-ink': '',
}
const pencil: astroHTML.JSX.SVGAttributes & { 'data-pencil': string } = {
  fill: 'none', stroke: '#8E8776', 'stroke-width': 0.18, 'stroke-linecap': 'round', opacity: 0.55, 'data-pencil': '',
}
// The head and its white throat, down to where the yellow of the breast begins; the bill is drawn over its front.
const head = 'M36.4 10.4 C36.2 8.4 35 7 33.3 6.4 C31.3 5.7 28.6 5.8 26.7 6.8 C24.9 7.8 24 9.8 24.1 12 C24.2 13.6 24.6 15 25.4 16.4 L26.8 17.8 C30 18.6 33.6 18.2 36.4 16.6 C37.2 15.4 37.3 13.9 36.8 12.6 Z'
const headLine = 'M25.4 16.4 C24.6 15 24.2 13.6 24.1 12 C24 9.8 24.9 7.8 26.7 6.8 C28.6 5.8 31.3 5.7 33.3 6.4 C35 7 36.2 8.4 36.4 10.4 M36.8 12.6 C37.3 13.9 37.2 15.4 36.6 16.8'
const body = 'M25.4 14.8 C29 16 33.4 16.8 36.6 16.8 C37.9 18.9 38.5 21.6 38.3 24 C38.1 28 36.6 31.8 33.8 34.8 C31.8 36.8 29.6 37.9 27.6 38 C25.6 38 24.2 36.6 23.4 34.6 C22.4 31.6 22.2 27.6 22.5 23.4 C22.8 20 23.8 17 25.4 14.8 Z'
const bodyLine = 'M36.6 16.8 C37.9 18.9 38.5 21.6 38.3 24 C38.1 28 36.6 31.8 33.8 34.8 C31.8 36.8 29.6 37.9 27.6 38'
// The folded wing covers the back: coverts above, then the long flight feathers down past the perch.
const wing = 'M25.4 15.8 C27 16.8 28.2 19 28.8 22 C29.4 25.6 29.2 29.6 28 33 C27.2 35.6 26 38.2 24.6 40.8 C24.3 41.4 23.6 41.3 23.5 40.6 C23 37.6 22.6 34.4 22.4 31 C22.2 27 22.4 23 23.2 19.8 C23.6 18 24.4 16.6 25.4 15.8 Z'
const tail = 'M24.2 35.6 C23.2 39.6 21.8 43.8 19.8 48 C21 48.9 22.6 49.1 24.4 48.8 C25.2 44.8 26.2 40.6 27.6 36.4 Z'
const branch = 'M2.2 41.2 C10 40.8 20 40.2 30 39.6 C38 39.1 44 38.4 49.2 37.2 C49.9 37.1 50.2 37.8 49.7 38.2 C44.4 39.8 38.4 41.4 30 42.2 C20 43 10 43.6 2.4 44.4'
const bill = 'M36.2 10.5 C38.3 10.4 40.5 10.8 42.3 11.4 C43 11.6 43.2 12.1 42.9 12.5 C42.7 12.7 42.5 12.6 42.4 12.3 C40.5 12.5 38.5 12.6 36.7 12.6 C36.3 11.9 36.2 11.2 36.2 10.5 Z'
const billLine = 'M36.2 10.5 C38.3 10.4 40.5 10.8 42.3 11.4 C43 11.6 43.2 12.1 42.9 12.5 C42.7 12.7 42.5 12.6 42.4 12.3 C40.5 12.5 38.5 12.6 36.7 12.6'
const leaf = 'M45.2 34.4 C46.4 32.4 48.6 31.4 50.8 31.6 C50 33.6 47.6 34.9 45.2 34.4 Z'
const leafSmall = 'M43.4 36 C43.2 34.4 43.8 33 45 32 C45.6 33.4 44.9 35 43.4 36 Z'
const eye = { x: 32.6, y: 10.9, r: 0.95 }
---
<svg class={`mascot ${className}`} viewBox="0 0 52 49" role="img" aria-label={label} data-mascot>
  <defs>
    <pattern id="mascot-hatch" width="1.1" height="1.1" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
      <line x1="0" y1="0" x2="0" y2="1.1" stroke={INK} stroke-width=".16" />
    </pattern>
    <pattern id="mascot-brush" width="1.4" height="1.4" patternUnits="userSpaceOnUse" patternTransform="rotate(62)">
      <line x1="0" y1="0" x2="0" y2="1.4" stroke="#F3E6C8" stroke-width=".12" />
    </pattern>
    <radialGradient id="mascot-fade"><stop offset=".15" stop-color="#fff" /><stop offset="1" stop-color="#000" /></radialGradient>
    <linearGradient id="mascot-down" x1="0" y1="0" x2="0" y2="1"><stop offset=".15" stop-color="#000" /><stop offset="1" stop-color="#fff" /></linearGradient>
    <clipPath id="mascot-head-shape"><path d={head} /></clipPath>
    <clipPath id="mascot-body-shape"><path d={body} /></clipPath>
    <clipPath id="mascot-wing-shape"><path d={wing} /></clipPath>
    <clipPath id="mascot-tail-shape"><path d={tail} /></clipPath>
    <clipPath id="mascot-branch-shape"><path d={`${branch} Z`} /></clipPath>
    <mask id="mascot-breast"><ellipse cx="32.8" cy="17.4" rx="5.6" ry="2" fill="url(#mascot-fade)" /></mask>
    <mask id="mascot-flank"><ellipse cx="27.8" cy="34.6" rx="5.4" ry="3.6" fill="url(#mascot-fade)" /></mask>
    <mask id="mascot-chin"><ellipse cx="34.4" cy="14.8" rx="2.6" ry="1.4" fill="url(#mascot-fade)" /></mask>
    <mask id="mascot-rump"><ellipse cx="24.4" cy="39" rx="2.6" ry="3" fill="url(#mascot-fade)" /></mask>
    <mask id="mascot-under"><rect x="0" y="38" width="52" height="7" fill="url(#mascot-down)" /></mask>
    <mask id="mascot-primaries"><rect x="21" y="31" width="11" height="11" fill="url(#mascot-down)" /></mask>
  </defs>

  <!-- Construction: the circle of the head, the oval of the body, the line of the pose and of the bill, the perch. -->
  <circle cx="30.4" cy="11.6" r="6.2" {...pencil} stroke-dasharray=".9 .7" />
  <ellipse cx="30.2" cy="26.6" rx="7" ry="11" transform="rotate(8 30.2 26.6)" {...pencil} stroke-dasharray=".9 .7" />
  <path d="M32 5 C31 18 27.6 33 21.4 49" {...pencil} />
  <path d="M27.6 10.6 L44.6 12.2" {...pencil} />
  <path d="M0.6 42.8 L51.4 38.2" {...pencil} />
  <path d={head} {...pencil} transform="translate(.4 -.35) rotate(.6 30 12)" />
  <path d={body} {...pencil} transform="translate(-.35 .3) rotate(-.5 30 27)" />

  <!-- The long tail hangs behind the perch: brown, its feathers edged in rufous. -->
  <g class="mascot-body">
    <path d={tail} fill={BROWN} data-wash />
    <g clip-path="url(#mascot-tail-shape)" data-wash>
      <path d="M24.8 37 C23.8 41 22.4 44.8 20.8 48.4" fill="none" stroke={RUFOUS} stroke-width=".6" stroke-linecap="round" />
      <path d="M26.8 37.2 C25.8 41 24.9 44.8 24.1 48.7" fill="none" stroke={RUFOUS} stroke-width=".5" stroke-linecap="round" />
      <path d="M25.8 37 C24.8 41 23.6 44.8 22.4 48.7" fill="none" stroke={INK} stroke-width=".16" opacity=".55" />
      <rect x="20" y="35" width="8" height="8" fill="url(#mascot-hatch)" mask="url(#mascot-rump)" opacity=".7" />
    </g>
    <path d={tail} {...ink} />
  </g>

  <!-- The perch: bark, a cut end, a twig with two leaves, its underside hatched. -->
  <g class="mascot-perch">
    <path d={`${branch} Z`} fill={BARK} data-wash />
    <g clip-path="url(#mascot-branch-shape)" data-wash>
      <rect x="0" y="38" width="52" height="7" fill="url(#mascot-hatch)" mask="url(#mascot-under)" opacity=".8" />
      <path d="M6 42.6 l2.4 -.2 M13.4 41.6 l3 -.25 M21 42.2 l2.2 -.15 M34.6 40.2 l2.6 -.3 M41 39.6 l2 -.3" stroke="#5E4530" stroke-width=".2" stroke-linecap="round" />
      <path d="M8.6 41.4 c.6 -.3 1.4 -.3 1.9 .1 M37.4 39.6 c.5 -.25 1.2 -.25 1.6 .1" fill="none" stroke="#E9D6B6" stroke-width=".18" stroke-linecap="round" opacity=".8" />
    </g>
    <ellipse cx="2.3" cy="42.8" rx=".9" ry="1.6" fill="#D2AE84" data-wash />
    <ellipse cx="2.3" cy="42.8" rx=".42" ry=".85" fill="none" stroke="#8C6B4C" stroke-width=".14" data-wash />
    <path d="M40.4 39 C42 37.4 43.4 35.8 45.2 34.4" fill="none" stroke={BARK} stroke-width=".7" stroke-linecap="round" data-wash />
    <path d={leaf} fill={LEAF} data-wash />
    <path d={leafSmall} fill={LEAF} data-wash />
    <path d="M45.4 34.3 C47 33.2 48.8 32.3 50.6 31.7 M43.5 35.8 C43.8 34.6 44.3 33.5 44.9 32.3" fill="none" stroke="#5F7340" stroke-width=".16" stroke-linecap="round" data-wash />
    <path d={branch} {...ink} />
    <path d={leaf} {...ink} stroke-width=".3" />
  </g>

  <g class="mascot-body">
    <!-- Sulphur-yellow underparts, deeper along the belly; the shadow of the head on the
         breast and of the wing on the flank; a few feather strokes. -->
    <path d={body} fill={SULPHUR} data-wash />
    <g clip-path="url(#mascot-body-shape)" data-wash>
      <path d="M20 13 L27 14.6 C25.4 17.4 24.2 20.6 23.6 24 L20 26 Z" fill={OLIVE} />
      <path d="M38.2 25 C37.8 30.4 35 35 30.6 37.3 C29.4 37.8 28.4 38 27.6 38 C31.6 35.6 34.8 31.6 36.6 27.6 C37.3 26.4 37.8 25.6 38.2 25 Z" fill={SULPHUR_DEEP} opacity=".5" />
      <g opacity=".5">
        <rect x="26" y="15" width="13" height="5" fill="url(#mascot-hatch)" mask="url(#mascot-breast)" />
        <rect x="22" y="30" width="13" height="9" fill="url(#mascot-hatch)" mask="url(#mascot-flank)" />
      </g>
    </g>
    <path d="M33.8 20.6 q.6 .5 1.2 0 M35.6 23.8 q.6 .5 1.2 0 M32.6 25.4 q.6 .5 1.2 0 M35.2 28.8 q.6 .5 1.2 0 M31.8 30.6 q.6 .5 1.2 0 M33.6 32.8 q.5 .45 1 0"
          fill="none" stroke={SULPHUR_DEEP} stroke-width=".26" stroke-linecap="round" data-wash />
    <path d={bodyLine} {...ink} />

    <!-- The folded wing: brown coverts with pale tips in rows, then the flight feathers, broadly edged in rufous. -->
    <path d={wing} fill={BROWN} data-wash />
    <g clip-path="url(#mascot-wing-shape)" data-wash>
      <path d="M21 14 L32 14 L32 25 C29 24 25.6 24.2 21.6 25.6 Z" fill={OLIVE_LIGHT} />
      <path d="M21 14 L32 14 L32 20 C29 19.6 25.6 19.8 21.6 21 Z" fill={OLIVE} />
      <path d="M21 14 L32 14 L32 25 C29 24 25.6 24.2 21.6 25.6 Z" fill="url(#mascot-brush)" opacity=".35" />
      <path d="M23.4 19.6 q.7 .7 1.4 0 q.7 .7 1.4 0 q.7 .7 1.4 0 M22.8 22.6 q.75 .75 1.5 0 q.75 .75 1.5 0 q.75 .75 1.5 0 q.75 .75 1.5 0"
            fill="none" stroke="#D9B47C" stroke-width=".28" stroke-linecap="round" />
      <path d="M22.4 25.4 C24.6 24.6 26.8 24.6 29 25.2" fill="none" stroke="#C98A4E" stroke-width=".5" stroke-linecap="round" />
      <path d="M28.4 26.4 C27.8 30.4 26.6 34 24.8 38.6 M27 26 C26.4 30 25.6 33.6 24.2 37.8 M25.6 25.9 C25 29.6 24.4 33.2 23.6 36.8 M24.2 26 C23.8 29.4 23.4 32.6 23 35.6"
            fill="none" stroke={RUFOUS} stroke-width=".5" stroke-linecap="round" />
      <path d="M27.8 26.2 C27.2 30.2 26 33.8 24.4 38.4 M26.4 25.9 C25.8 29.8 25 33.4 23.9 37.4 M24.9 25.9 C24.4 29.4 23.9 32.8 23.3 36.2"
            fill="none" stroke={INK} stroke-width=".15" stroke-linecap="round" opacity=".55" />
      <rect x="21" y="31" width="11" height="11" fill="url(#mascot-hatch)" mask="url(#mascot-primaries)" opacity=".45" />
    </g>
    <path d={wing} {...ink} />
  </g>

  <!-- Short dark legs, the toes wrapped round the perch. -->
  <g fill="none" stroke={INK} stroke-linecap="round" stroke-linejoin="round" data-wash>
    <path d="M29.2 37.4 L29.5 39.5 M31 37.2 L31.4 39.3" stroke-width=".5" />
    <path d="M29.5 39.4 C30.3 39.1 31 39.3 31.3 40 M29.5 39.4 C28.8 39.5 28.3 39.9 28.1 40.5 M31.4 39.2 C32.2 38.9 32.9 39.1 33.2 39.8 M31.4 39.2 C30.8 39.3 30.4 39.7 30.3 40.2" stroke-width=".32" />
  </g>

  <g class="mascot-head">
    <path d={head} fill={WHITE} data-wash />
    <!-- A thin black cap with the yellow of its hidden crest showing; the broad white brow, meeting on the forehead and
         running round to the nape; the black mask from the bill through the eye and down the side of the neck. -->
    <g clip-path="url(#mascot-head-shape)" data-wash>
      <path d="M22 3 L40 3 L40 9.2 C38.6 8.6 37.2 8.3 35.8 8.4 C33.6 7.8 31 7.6 28.6 8 C26.8 8.3 25.2 9.1 23.8 10.4 L22 11.4 Z" fill={INK} />
      <path d="M37.4 10.6 C35.8 10.4 34.4 9.9 32.8 9.8 C30.6 9.6 28.4 10.1 26.4 11 C25.2 11.6 24.2 12.4 23.4 13.4 L22 19.6 L26.6 18.6 C26.4 16.8 26.7 15.2 27.8 14.2 C30.2 12.9 33.6 12.3 37.4 12.3 Z" fill={INK} />
      <path d="M22 15.6 C23.4 15.2 24.8 15.6 25.8 16.8 C26.2 17.4 26.4 18 26.4 18.6 L22 19.4 Z" fill={OLIVE} />
      <path d="M28.8 6.3 C30.2 6 31.8 6 33.2 6.4" fill="none" stroke={SULPHUR} stroke-width=".5" stroke-linecap="round" />
      <path d="M29.6 6.6 C30.8 6.4 32 6.4 32.8 6.6" fill="none" stroke="#E08A2E" stroke-width=".2" stroke-linecap="round" opacity=".8" />
      <rect x="31" y="13" width="6" height="4" fill="url(#mascot-hatch)" mask="url(#mascot-chin)" opacity=".45" />
    </g>
    <path d={headLine} {...ink} />
    <!-- A dark brown eye with its pupil and a catchlight, set in the mask. -->
    <g class="mascot-eye" data-eye data-reach=".25">
      <circle cx={eye.x} cy={eye.y} r={eye.r} fill="#4A2E1A" data-wash />
      <circle cx={eye.x} cy={eye.y} r=".52" fill={INK} data-wash />
      <circle cx={eye.x + 0.32} cy={eye.y - 0.34} r=".22" fill={WHITE} data-wash data-pupil />
      <!-- The eyelid hangs from the top of the eye (its group's origin), so scaling it from 0 0 closes it; open, it has
           no height. -->
      <g transform={`translate(${eye.x} ${eye.y - 1.05})`}>
        <ellipse cx="0" cy="1.05" rx="1.1" ry="1.05" fill={INK} data-lid transform="scale(1 0)" />
      </g>
    </g>
    <!-- The stout black bill, about half the head long and hooked at the tip, with a sheen along the ridge and the
         nostril. -->
    <path d={bill} fill={INK} data-wash />
    <path d="M37.1 10.9 C38.7 10.9 40.3 11.1 41.5 11.4" fill="none" stroke="#6E6A60" stroke-width=".25" stroke-linecap="round" opacity=".8" data-wash />
    <ellipse cx="37.7" cy="11.05" rx=".28" ry=".15" fill="#4A463C" data-wash />
    <path d={billLine} {...ink} />
    <path d="M36.7 11.6 C38.5 11.7 40.5 11.8 42.3 12.1" {...ink} stroke-width=".22" />
  </g>
</svg>

<style>
  .mascot { width: 100%; height: auto; overflow: visible; }
  /* Until the script draws it (or gives up), the drawing stays hidden: no flash of the finished plate. */
  :global(html.pending) .mascot { visibility: hidden; }
</style>
