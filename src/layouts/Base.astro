---
import { Font } from 'astro:assets'
import 'lenis/dist/lenis.css'
import '../styles/global.css'
import type { Content } from '../i18n/content'
import { BRAND, REPO } from '../i18n/content'
import Bug from '../components/Bug.astro'
import { withBase } from '../paths'
import paperTooth from '../assets/paper/paper-tooth.webp'
import paperCloud from '../assets/paper/paper-cloud.webp'
import deskTooth from '../assets/paper/desk-tooth.webp'
import deskCloud from '../assets/paper/desk-cloud.webp'

// notFound: the 404, served at any address that doesn't exist. It isn't indexed, claims no address of its own and
// its menu leads to the sections of the home page.
interface Props { t: Content; path?: string; notFound?: boolean }
const { t, path = '/', notFound = false } = Astro.props
const canonical = new URL(withBase(path), Astro.site)
const english = new URL(withBase(path.replace(/^\/es(\/|$)/, '/')), Astro.site)
const spanish = new URL(withBase(path.startsWith('/es') ? path : `/es${path === '/' ? '/' : path}`), Astro.site)
const title = notFound ? t.notFound.title : t.meta.title
const description = notFound ? t.notFound.body : t.meta.description
const home = withBase(t.lang === 'es' ? '/es/' : '/')
const section = (id: string) => notFound ? `${home}#${id}` : `#${id}`
const other = t.lang === 'es' ? 'en' : 'es'
const locale: Record<string, string> = { en: 'en_US', es: 'es_LA' }
---
<!doctype html>
<html lang={t.lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="en" href={english} />
      <link rel="alternate" hreflang="es" href={spanish} />
      <link rel="alternate" hreflang="x-default" href={english} />
    </>}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf5e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content={locale[t.lang]} />
    <meta property="og:locale:alternate" content={locale[other]} />
    <meta property="og:image" content={new URL(withBase(`/og-${t.lang}.jpg`), Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(withBase(`/og-${t.lang}.jpg`), Astro.site)} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-hand" preload />
    <!-- Every font and the paper are asked for up front: a page (above all one reached by changing language, mid page
         turn) must not paint first with a fallback font or flat paper and then swap them in, which reads as a flicker.
         The cards are paper in both themes (the 404's drawing is on one too); the desk tiles only matter at night. -->
    <link rel="preload" as="image" href={paperTooth.src} type="image/webp" />
    <link rel="preload" as="image" href={paperCloud.src} type="image/webp" />
    <link rel="preload" as="image" href={deskTooth.src} type="image/webp" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="image" href={deskCloud.src} type="image/webp" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Before paint: JS is here, and whether this visitor turned motion off (a convenience; it may be unavailable).
      document.documentElement.classList.replace('no-js', 'js')
      try {
        if (localStorage.getItem('pitangus-motion') === 'off') document.documentElement.classList.add('still')
        // Arriving from the other language, the page turns (a view transition): it must already be complete, not blank
        // waiting for its entrance, or the turn shows an empty page that then fills in.
        const turned = sessionStorage.getItem('pitangus-turn') === '1'
        sessionStorage.removeItem('pitangus-turn')
        if (!turned && !document.documentElement.classList.contains('still') && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          document.documentElement.classList.add('pending')
          setTimeout(() => document.documentElement.classList.remove('pending'), 1500)  // the script never came: show everything
        }
        const theme = localStorage.getItem('pitangus-theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <header class="top">
      <div class="wrap top-row">
        <!-- The logo on paper; at night, the icon (the same head on its paper tile): a black head would sink into the desk. -->
        <a class="brand" href={home} aria-label={BRAND}>
          <img class="brand-day" src={withBase('/logo.svg')} alt="" width="34" height="34" />
          <img class="brand-night" src={withBase('/favicon.svg')} alt="" width="32" height="32" />
          <span class="brand-word">{BRAND}</span>
        </a>
        <nav aria-label={t.nav.label} class="nav">
          <a href={section('specimens')}>{t.nav.specimens}</a>
          <a href={section('change')}>{t.nav.change}</a>
          <a href={section('ledger')}>{t.nav.ledger}</a>
          <a href={section('install')}>{t.nav.install}</a>
        </nav>
        <div class="tools">
          <p class="counter mono">
            <span class="visually-hidden">{t.counter.aria}:</span> <Bug size={18} /> <span data-counter>0</span> <span class="counter-label" data-counter-label data-one={t.counter.one} data-other={t.counter.label}>{t.counter.label}</span>
          </p>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label={t.theme.label} title={t.theme.label}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <g class="sun"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></g>
              <path class="moon" d="M19.5 14.6A7.8 7.8 0 0 1 9.4 4.5 7.8 7.8 0 1 0 19.5 14.6Z" />
            </svg>
          </button>
          <button class="motion-toggle mono" type="button" data-motion-toggle
                  data-pause={t.motion.pause} data-play={t.motion.play}>
            <svg class="motion-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <g class="pause" fill="currentColor"><rect x="3" y="2.5" width="3.4" height="11" rx="1" /><rect x="9.6" y="2.5" width="3.4" height="11" rx="1" /></g>
              <path class="play" d="M4 2.5v11l9-5.5Z" fill="currentColor" />
            </svg>
            <span class="motion-label" data-motion-label>{t.motion.pause}</span>
          </button>
          <a class="lang mono" href={withBase(t.nav.otherHref)} data-turn hreflang={other} lang={other}>{t.nav.other}</a>
          <a class="code mono" href={REPO}>{t.nav.code} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>
    <slot />
    <script>
      import { start } from '../scripts/motion'
      start()
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky; top: 0; z-index: 40;
    /* Solid paper, not a blur of what scrolls under it: blurring the page on every scrolled frame is costly. */
    background-color: var(--paper); background-image: var(--page-tooth), var(--page-cloud); background-size: 300px, 640px;
    border-bottom: 1px solid var(--rule);
  }
  .top-row { display: flex; align-items: center; gap: 1.5rem; min-height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; }
  .brand-word { font-family: var(--font-display), Georgia, serif; font-size: 1.7rem; line-height: 1; letter-spacing: -0.005em; }
  .brand-night { display: none; border-radius: 7px; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .brand-night { display: block; } :global(:root:not([data-theme="light"])) .brand-day { display: none; } }
  :global(:root[data-theme="dark"]) .brand-night { display: block; }
  :global(:root[data-theme="dark"]) .brand-day { display: none; }
  .nav { display: flex; gap: 1.5rem; margin-inline: auto; font-size: 0.95rem; }
  .nav a { text-decoration: none; }
  .tools { display: flex; align-items: center; gap: 1rem; font-size: 0.8rem; }
  .tools a, .motion-toggle { text-decoration: none; }
  .counter { display: inline-flex; align-items: center; gap: 0.35rem; margin: 0; padding: 0.3rem 0.65rem; border: 1px solid var(--rule); border-radius: 999px; }
  .counter [data-counter] { font-weight: 600; min-width: 1ch; text-align: right; }
  .motion-toggle {
    background: none; border: 0; padding: 0.4rem 0; color: var(--muted); cursor: pointer; font-size: 0.8rem;
    text-decoration: underline; text-underline-offset: 0.2em; min-height: 44px;
  }
  .motion-toggle:hover { color: var(--accent); }
  .motion-toggle { display: inline-flex; align-items: center; gap: 0.4rem; }
  .motion-icon .play { display: none; }
  :global(html.still) .motion-icon .pause { display: none; }
  :global(html.still) .motion-icon .play { display: block; }
  /* With reduced motion nothing moves anyway: nothing to pause. */
  @media (prefers-reduced-motion: reduce) { .motion-toggle { display: none; } }
  .theme-toggle { display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: none; color: var(--ink); cursor: pointer; border-radius: 50%; }
  .theme-toggle:hover { color: var(--accent); }
  .theme-toggle .moon { display: none; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .theme-toggle .moon { display: block; } :global(:root:not([data-theme="light"])) .theme-toggle .sun { display: none; } }
  :global(:root[data-theme="dark"]) .theme-toggle .moon { display: block; }
  :global(:root[data-theme="dark"]) .theme-toggle .sun { display: none; }
  .tools a, .nav a, .counter { white-space: nowrap; }
  /* Below a full desktop width the counter and the motion toggle keep only their icon, so nothing wraps. */
  @media (max-width: 84rem) {
    .counter-label { display: none; }
    .motion-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .motion-toggle { justify-content: center; min-width: 44px; text-decoration: none; }
  }
  @media (max-width: 64rem) { .nav { display: none; } .tools { margin-left: auto; } }
  @media (max-width: 40rem) {
    .code { display: none; }
    .tools { gap: 0.5rem; }
    .brand-word { display: none; }
  }
</style>
