---
import Base from '../layouts/Base.astro'
import Mascot from '../components/Mascot.astro'
import { content } from '../i18n/content'
import { withBase } from '../paths'
const t = content.en
const es = content.es
---
<Base t={t} notFound>
  <main id="content" class="wrap lost">
    <!-- The drawing on its sheet of paper, as on the landing: at night a black crown and bill would sink into the desk. -->
    <div class="lost-art"><div class="lost-sheet card-paper"><Mascot label={t.hero.drawing} /></div></div>
    <div>
      <p class="kicker">404</p>
      <h1 class="display">{t.notFound.title}</h1>
      <p class="lead">{t.notFound.body}</p>
      <p><a class="button primary" href={withBase('/')}>{t.notFound.back}</a></p>
      <p class="muted" lang="es">{es.notFound.title} <a href={withBase('/es/')}>{es.notFound.back}</a></p>
    </div>
  </main>
</Base>
<style>
  .lost { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 3rem; align-items: center; min-height: 75vh; }
  .lost h1 { font-size: clamp(2.6rem, 2rem + 4vw, 5.5rem); margin: 0.5rem 0 1rem; }
  .lost-art { max-width: 24rem; animation: bob 1.6s var(--ease) 3; transform-origin: 55% 85%; }
  .lost-sheet { padding: 12% 10% 14%; border: 1px solid var(--rule); transform: rotate(-0.8deg);
                background-color: color-mix(in oklab, var(--card-deep) 55%, var(--card)); box-shadow: 0 18px 30px -24px rgb(28 26 22 / 0.45); }
  :global(html.still) .lost-art { animation: none; }
  /* The kiskadee bobs on its perch, looking around. */
  @keyframes bob { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(-2.5deg) translateY(3px); } 60% { transform: rotate(1.5deg); } }
  @media (max-width: 48rem) { .lost { grid-template-columns: 1fr; } }
</style>
